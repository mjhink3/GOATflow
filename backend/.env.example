# Copy this file to .env and fill in the values before starting the server.

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/goatflow

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret — use a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: username that gets admin access (invite management)
ADMIN_USERNAME=

# Optional: cap on total registered users (default 50)
MAX_USERS=50
